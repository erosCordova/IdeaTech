# ============================================================
# IdeaTech API — variables de entorno del backend
# Copia este archivo a  backend/.env  y completa los valores.
# NUNCA subas el .env real al repositorio (ya está en .gitignore).
# ============================================================

# --- Supabase (obligatorio) ---------------------------------
# URL del proyecto: Supabase Dashboard → Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co

# secret key / service_role key (SOLO del lado del servidor).
# Jamás uses aquí la publishable key del frontend.
SUPABASE_SECRET_KEY=eyJhbGciOi...tu_service_role_key

# --- CORS ----------------------------------------------------
# Origen autorizado extra además del entorno local.
# En producción pon la URL pública del frontend desplegado.
FRONTEND_URL=http://localhost:5173

# --- Metadatos de la API (opcionales) ------------------------
NOMBRE_APLICACION=IdeaTech API
VERSION=1.0.0
ENTORNO=desarrollo
