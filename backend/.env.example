# URL pública del proyecto de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave secreta exclusiva del backend
# Nunca debe utilizarse en el frontend
SUPABASE_SECRET_KEY=tu_clave_secreta_del_backend

# URL del frontend autorizado
# En producción será la URL de Vercel
FRONTEND_URL=https://tu-proyecto.vercel.app

# Entorno de ejecución
ENTORNO=produccion